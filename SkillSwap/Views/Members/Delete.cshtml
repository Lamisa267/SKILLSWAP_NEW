@model SkillSwap.Models.Member

@{
ViewData["Title"] = "Delete Member";
}

<div class="members-page">

```
<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="member-card text-center">

                <div style="
                    width:75px;
                    height:75px;
                    margin:0 auto 20px;
                    border-radius:50%;
                    background:#fff0f0;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:32px;">
                    🗑
                </div>

                <div class="page-label">
                    SkillSwap Community
                </div>

                <h1 class="members-title"
                    style="font-size:32px;">
                    Delete Member
                </h1>

                <p class="members-subtitle mb-4">
                    Are you sure you want to delete this member?
                </p>

                <div style="
                    background:#f7faf9;
                    border-radius:14px;
                    padding:25px;
                    margin-bottom:25px;
                    text-align:left;">

                    <div style="
                        color:#173f3b;
                        font-size:22px;
                        font-weight:700;
                        margin-bottom:8px;">
                        @Model.Name
                    </div>

                    <div style="
                        color:#7a8886;
                        font-size:14px;
                        margin-bottom:8px;">
                        ✉ @Model.Email
                    </div>

                    <div style="
                        color:#657471;
                        font-size:14px;
                        margin-bottom:15px;">
                        ☎ @Model.PhoneNumber
                    </div>

                    <div class="skill-section">
                        <div class="skill-title">
                            Skill I Can Teach
                        </div>

                        <span class="skill-badge teach-skill">
                            @Model.SkillToOffer
                        </span>
                    </div>

                    <div class="skill-section">
                        <div class="skill-title">
                            Skill I Want To Learn
                        </div>

                        <span class="skill-badge learn-skill">
                            @Model.SkillToLearn
                        </span>
                    </div>

                </div>

                <form asp-controller="Members"
                      asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-center gap-2">

                        <a asp-controller="Members"
                           asp-action="Index"
                           class="action-btn view-btn"
                           style="flex:0 0 auto; padding:11px 22px;">
                            Cancel
                        </a>

                        <button type="submit"
                                class="action-btn delete-btn"
                                style="
                                    border:none;
                                    cursor:pointer;
                                    flex:0 0 auto;
                                    padding:11px 22px;">
                            Delete Member
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
```

</div>
