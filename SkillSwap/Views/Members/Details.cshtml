@model SkillSwap.Models.Member

@{
    ViewData["Title"] = "Member Profile";
}

<div class="container py-5">

    ```
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div style="font-size:60px;">
                            👤
                        </div>

                        <h1 class="fw-bold mt-2" style="color:#173f3b;">
                            @Model.Name
                        </h1>

                        <p class="text-muted">
                            SkillSwap Member Profile
                        </p>

                    </div>

                    <div class="p-4 rounded-3 mb-4"
                         style="background:#f7faf9;">

                        <h5 class="fw-bold mb-3" style="color:#173f3b;">
                            About
                        </h5>

                        <p class="text-muted mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Bio)
                                ? "No bio provided."
                                : Model.Bio)
                        </p>

                    </div>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">

                                <small class="text-muted">
                                    Email
                                </small>

                                <div class="fw-semibold mt-1">
                                    @Model.Email
                                </div>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">

                                <small class="text-muted">
                                    Phone
                                </small>

                                <div class="fw-semibold mt-1">
                                    @Model.PhoneNumber
                                </div>

                            </div>
                        </div>

                    </div>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <div class="p-4 rounded-3 h-100"
                                 style="background:#eaf6f2;">

                                <small class="text-muted">
                                    Skill I Can Teach
                                </small>

                                <h5 class="fw-bold mt-2"
                                    style="color:#173f3b;">
                                    @Model.SkillToOffer
                                </h5>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="p-4 rounded-3 h-100"
                                 style="background:#f3f0fa;">

                                <small class="text-muted">
                                    Skill I Want To Learn
                                </small>

                                <h5 class="fw-bold mt-2"
                                    style="color:#173f3b;">
                                    @Model.SkillToLearn
                                </h5>

                            </div>

                        </div>

                    </div>

                    <div class="text-center text-muted mb-4">

                        Joined:
                        @Model.JoinedDate.ToLocalTime().ToString("dd MMMM yyyy")

                    </div>

                    <div class="d-flex justify-content-center gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn px-4"
                           style="background:#2b8a78;color:white;">
                            Edit Profile
                        </a>

                        <a asp-action="Index"
                           class="btn btn-light px-4">
                            Back to Members
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>
    ```

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
