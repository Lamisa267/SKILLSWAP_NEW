@model SkillSwap.Models.Skill

@{
    ViewData["Title"] = "Delete Skill";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5 text-center">

                    <div class="mb-4">
                        <span class="badge bg-danger">
                            Delete Skill
                        </span>
                    </div>

                    <h2 class="fw-bold mb-3">
                        Delete this skill?
                    </h2>

                    <p class="text-muted mb-4">
                        Are you sure you want to permanently delete this skill?
                        This action cannot be undone.
                    </p>

                    <div class="border rounded p-3 mb-4 text-start">

                        <h4 class="fw-bold mb-2">
                            @Model.Name
                        </h4>

                        <p class="text-muted mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description provided."
                                : Model.Description)
                        </p>

                    </div>

                    <form asp-controller="Skills"
                          asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger flex-grow-1">
                                Yes, Delete
                            </button>

                            <a asp-controller="Skills"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>