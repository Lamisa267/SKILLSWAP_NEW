<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    ```
    <title>@ViewData["Title"] - SkillSwap</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #f7faf9;
                color: #173f3b;
            }

            /* NAVBAR */

            .skillswap-navbar {
                background: #ffffff;
                border-bottom: 1px solid #e7eeee;
                padding: 14px 0;
                box-shadow: 0 2px 12px rgba(30, 70, 65, 0.05);
            }

            .brand {
                color: #267a6b !important;
                font-size: 24px;
                font-weight: 750;
                text-decoration: none;
                letter-spacing: -0.5px;
            }

                .brand span {
                    color: #173f3b;
                }

            .nav-link {
                color: #566765 !important;
                font-size: 15px;
                font-weight: 600;
                margin-left: 8px;
                padding: 9px 14px !important;
                border-radius: 8px;
                transition: 0.2s;
            }

                .nav-link:hover {
                    background: #eaf5f2;
                    color: #267a6b !important;
                }

                .nav-link.active {
                    background: #eaf5f2;
                    color: #267a6b !important;
                }

            .join-btn {
                background: #2b8a78;
                color: white !important;
                padding: 9px 18px !important;
                border-radius: 9px;
                margin-left: 10px;
            }

                .join-btn:hover {
                    background: #216c60;
                    color: white !important;
                }

            /* AUTH BUTTONS */

            .login-btn {
                border: 1px solid #2b8a78;
                color: #267a6b !important;
                padding: 8px 16px !important;
                border-radius: 9px;
                margin-left: 10px;
            }

                .login-btn:hover {
                    background: #eaf5f2;
                }

            .register-btn {
                background: #2b8a78;
                color: white !important;
                padding: 9px 16px !important;
                border-radius: 9px;
                margin-left: 8px;
            }

                .register-btn:hover {
                    background: #216c60;
                    color: white !important;
                }

            .user-name {
                color: #267a6b;
                font-weight: 700;
                padding: 9px 12px;
                margin-left: 10px;
            }

            .logout-btn {
                border: none;
                background: transparent;
                color: #566765;
                font-size: 15px;
                font-weight: 600;
                padding: 9px 14px;
                border-radius: 8px;
                margin-left: 5px;
            }

                .logout-btn:hover {
                    background: #eaf5f2;
                    color: #267a6b;
                }

            /* MAIN */

            main {
                min-height: calc(100vh - 145px);
            }

            /* FOOTER */

            .skillswap-footer {
                background: #173f3b;
                color: #dceae7;
                padding: 28px 0;
                margin-top: 40px;
            }

            .footer-brand {
                color: #ffffff;
                font-size: 20px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .footer-text {
                color: #b9cdca;
                font-size: 14px;
                margin: 0;
            }

            .footer-copy {
                color: #9db6b1;
                font-size: 13px;
                text-align: right;
            }

    </style>
    ```

</head>

<body>

    ```
    <!-- NAVBAR -->

    <header>

        <nav class="navbar navbar-expand-lg skillswap-navbar">

            <div class="container">

                <!-- LOGO -->

                <a class="brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Skill<span>Swap</span>
                </a>


                <!-- MOBILE MENU BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <!-- SKILLS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Skills"
                               asp-action="Index">

                                Skills

                            </a>

                        </li>


                        <!-- MEMBERS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Members"
                               asp-action="Index">

                                Members

                            </a>

                        </li>


                        <!-- SWAP REQUESTS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="SwapRequests"
                               asp-action="Index">

                                Skill Exchange

                            </a>

                        </li>


                        <!-- ABOUT -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">

                                About

                            </a>

                        </li>


                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- LOGGED IN USER -->

                            <li class="nav-item">

                                <span class="user-name">
                                    Hello, @User.Identity.Name
                                </span>

                            </li>


                            <!-- LOGOUT -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="logout-btn">

                                        Logout

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- LOGIN -->

                            <li class="nav-item">

                                <a class="nav-link login-btn"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>


                            <!-- REGISTER -->

                            <li class="nav-item">

                                <a class="nav-link register-btn"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>
                        }


                        <!-- JOIN -->

                        <li class="nav-item">

                            <a class="nav-link join-btn"
                               asp-controller="Members"
                               asp-action="Create">

                                + Join SkillSwap

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- MAIN CONTENT -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- FOOTER -->

    <footer class="skillswap-footer">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-md-7">

                    <div class="footer-brand">
                        SkillSwap
                    </div>

                    <p class="footer-text">
                        Learn skills. Share knowledge. Grow together.
                    </p>

                </div>

                <div class="col-md-5">

                    <div class="footer-copy">
                        © @DateTime.Now.Year SkillSwap. All rights reserved.
                    </div>

                </div>

            </div>

        </div>

    </footer>


    <!-- BOOTSTRAP JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    ```

</body>
</html>
